 ㄹ 실행:  JTBC examples/C예제.ㄹ        (컴파일 후 실행)
 ㄹ 진상규명:  JTBC examples/C예제.ㄹ -c  (생성된 C 보기)
 ㄹ/
전부 이렇게 해 가지고 K-팩토리얼 으로 들어가도록(n) {
    만약 (n <= 1) { 완료 1; }
    완료 n * K-팩토리얼(n - 1);
}

전부 이렇게 해 가지고 K-피보나치 으로 들어가도록(n) {
    만약 (n < 2) { 완료 n; }
    완료 K-피보나치(n - 1) 더하기 K-피보나치(n - 2);
}

사회 {
    콘솔.로그("팩토리얼 10 은 이것이다:", K-팩토리얼(10));
    콘솔.로그("피보나치 20 은 이것이다:", K-피보나치(20));

    공천 합 는 이것이다 0;
    공천 i 는 이것이다 0;
    될때까지 (i < 5) {
        i++;
        합 += i;
        콘솔.로그("누적 합 =", 합);
    }
    콘솔.로그("바쁜 ${i}번 돌았다. 슬퍼할 시간이 없다.");
}
